<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Follow_Up_Status__c</fullName>
    <label>Follow-Up Status</label>
    <description>Tracks the resolution status of follow-up actions identified by the Service Priority Dashboard.</description>
    <required>false</required>
    <type>Picklist</type>
    <picklist>
        <picklistValues>
            <fullName>Needs Review</fullName>
            <default>true</default>
        </picklistValues>
        <picklistValues>
            <fullName>In Progress</fullName>
            <default>false</default>
        </picklistValues>
        <picklistValues>
            <fullName>Resolved</fullName>
            <default>false</default>
        </picklistValues>
        <picklistValues>
            <fullName>No Action Needed</fullName>
            <default>false</default>
        </picklistValues>
    </picklist>
</CustomField>