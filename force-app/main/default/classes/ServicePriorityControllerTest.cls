/**\n * ServicePriorityControllerTest\n *\n * Test class for ServicePriorityController and ServicePriorityHelper.\n * Covers: date range querying, default-to-yesterday, classification logic,\n * signal detection, priority assignment, conversation history, activity feed.\n */\n@isTest\nprivate class ServicePriorityControllerTest {\n\n    @TestSetup\n    static void setupTestData() {\n        // Create Account\n        Account acc = new Account(\n            Name = 'Test Site ABC',\n            Credit_hold__c = false\n        );\n        insert acc;\n\n        // Create Contact\n        Contact con = new Contact(\n            AccountId = acc.Id,\n            LastName = 'Smith',\n            Phone = '555-0100',\n            Email = 'smith@test.com'\n        );\n        insert con;\n\n        // Create Asset\n        Asset ast = new Asset(\n            Name = 'RTU-4',\n            AccountId = acc.Id,\n            SerialNumber = 'SN-12345',\n            Model_Number__c = 'ABC-100'\n        );\n        insert ast;\n\n        // Create WorkOrder\n        WorkOrder wo = new WorkOrder(\n            AccountId = acc.Id,\n            ContactId = con.Id,\n            AssetId = ast.Id,\n            Status = 'In Progress',\n            Service_Notes__c = 'Customer reported no cooling. Unit running but warm air blowing.',\n            Executive_Summary__c = 'Technician found compressor not engaging. Recommend compressor replacement - $4,200.',\n            Next_Steps__c = 'Awaiting customer approval for compressor replacement quote.',\n            Callback__c = true\n        );\n        insert wo;\n\n        // Create ServiceAppointment (yesterday)\n        Date yesterday = Date.today().addDays(-1);\n        DateTime schedStart = DateTime.newInstance(yesterday, Time.newInstance(8, 0, 0, 0));\n        DateTime schedEnd = DateTime.newInstance(yesterday, Time.newInstance(10, 30, 0, 0));\n\n        ServiceAppointment sa = new ServiceAppointment(\n            ParentRecordId = wo.Id,\n            Status = 'Completed',\n            SchedStartTime = schedStart,\n            SchedEndTime = schedEnd,\n            EarliestStartTime = schedStart,\n            DueDate = schedEnd\n        );\n        insert sa;\n\n        // Link SA to WO via standard FSL field\n        wo.ServiceAppointmentId = sa.Id;\n        update wo;\n\n        // Create WorkOrderLineItem with recommendation signal\n        WorkOrderLineItem woli = new WorkOrderLineItem(\n            WorkOrderId = wo.Id,\n            Description = 'Checked compressor - recommend replacement. Unit non-operational.',\n            Status = 'Completed'\n        );\n        insert woli;\n\n        // Create a ConversationEntry (customer asking for update)\n        ConversationEntry entry = new ConversationEntry(\n            ParentRecordId = wo.Id,\n            MessageBody = 'Hi, just checking on the status - when will someone come back to fix the AC?',\n            ReceivedTime = System.now().addHours(-2),\n            Direction = 'Inbound',\n            MessageType = 'SMS'\n        );\n        insert entry;\n\n        // Create a FeedItem on the WO\n        FeedItem feed = new FeedItem(\n            ParentId = wo.Id,\n            Title = 'Customer called asking for ETA',\n            Body = 'Spoke with John at site - he needs cooling back ASAP. Escalating to dispatch.',\n            Type = 'TextPost'\n        );\n        insert feed;\n    }\n\n    @isTest\n    static void testGetAppointments_DefaultsToYesterday() {\n        Test.startTest();\n        List<ServicePriorityController.AppointmentWrapper> appts =\n            ServicePriorityController.getAppointments(null, null);\n        Test.stopTest();\n\n        Assert.isFalse(appts.isEmpty(), 'Should return appointments for yesterday');\n        Assert.areEqual('Test Site ABC', appts[0].accountName);\n    }\n\n    @isTest\n    static void testGetAppointments_DateRange() {\n        Date yesterday = Date.today().addDays(-1);\n        Date today = Date.today();\n\n        Test.startTest();\n        List<ServicePriorityController.AppointmentWrapper> appts =\n            ServicePriorityController.getAppointments(yesterday, today);\n        Test.stopTest();\n\n        Assert.isFalse(appts.isEmpty(), 'Should return appointments for date range');\n    }\n\n    @isTest\n    static void testGetAppointments_InvalidRange() {\n        Date today = Date.today();\n        Date yesterday = Date.today().addDays(-1);\n\n        Test.startTest();\n        try {\n            ServicePriorityController.getAppointments(today, yesterday);\n            Assert.fail('Should have thrown because start > end');\n        } catch (AuraHandledException e) {\n            Assert.isTrue(e.getMessage().contains('Start date must be before'),\n                'Expected date order error');\n        }\n        Test.stopTest();\n    }\n\n    @isTest\n    static void testGetAppointments_ExcessiveRange() {\n        Date start = Date.today().addDays(-60);\n        Date end = Date.today();\n\n        Test.startTest();\n        try {\n            ServicePriorityController.getAppointments(start, end);\n            Assert.fail('Should have thrown for >31 day range');\n        } catch (AuraHandledException e) {\n            Assert.isTrue(e.getMessage().contains('31 days'),\n                'Expected range limit error');\n        }\n        Test.stopTest();\n    }\n\n    @isTest\n    static void testGetFollowUpAnalysis_UrgentDetection() {\n        // Fetch the SA we created\n        ServiceAppointment sa = [SELECT Id, WorkOrder__r.Id,\n                                        WorkOrder__r.Status,\n                                        WorkOrder__r.Service_Notes__c,\n                                        WorkOrder__r.Executive_Summary__c,\n                                        WorkOrder__r.Callback__c\n                                 FROM ServiceAppointment LIMIT 1];\n\n        List<WorkOrderLineItem> wolis = [SELECT Id, WorkOrderId, Description, Status\n                                          FROM WorkOrderLineItem\n                                          WHERE WorkOrderId = :sa.WorkOrder__r.Id];\n\n        List<ConversationEntry> entries = [SELECT Id, ParentRecordId, MessageBody,\n                                                  ReceivedTime, Direction\n                                           FROM ConversationEntry\n                                           WHERE ParentRecordId = :sa.WorkOrder__r.Id];\n\n        Test.startTest();\n        ServicePriorityController.FollowUpResult result =\n            ServicePriorityHelper.classify(sa, wolis, entries);\n        Test.stopTest();\n\n        Assert.isTrue(result.needsFollowUp, 'Should detect follow-up needed');\n        Assert.areEqual('Urgent', result.priority,\n            'Should classify as Urgent (compressor non-operational + customer inquiry + callback)');\n        Assert.isTrue(result.signalCount >= 3,\n            'Should have multiple signals (recommendation, callback, customer message)');\n        Assert.isTrue(String.isNotBlank(result.summary),\n            'Should have a generated summary');\n    }\n\n    @isTest\n    static void testGetFollowUpAnalysis_CompletedNoIssues() {\n        // Create a clean WO/SA with no follow-up signals\n        Account acc = [SELECT Id FROM Account LIMIT 1];\n        WorkOrder cleanWO = new WorkOrder(\n            AccountId = acc.Id,\n            Status = 'Completed',\n            Executive_Summary__c = 'PM inspection completed. All equipment operating within normal parameters.'\n        );\n        insert cleanWO;\n\n        Date yesterday = Date.today().addDays(-1);\n        ServiceAppointment cleanSA = new ServiceAppointment(\n            ParentRecordId = cleanWO.Id,\n            Status = 'Completed',\n            SchedStartTime = DateTime.newInstance(yesterday, Time.newInstance(13, 0, 0, 0)),\n            SchedEndTime = DateTime.newInstance(yesterday, Time.newInstance(15, 0, 0, 0))\n        );\n        insert cleanSA;\n\n        Test.startTest();\n        ServicePriorityController.FollowUpResult result =\n            ServicePriorityHelper.classify(cleanSA, null, null);\n        Test.stopTest();\n\n        Assert.isFalse(result.needsFollowUp, 'Clean PM should not need follow-up');\n        Assert.areEqual('Low', result.priority, 'Clean PM should be Low priority');\n    }\n\n    @isTest\n    static void testGetConversationHistory() {\n        WorkOrder wo = [SELECT Id FROM WorkOrder LIMIT 1];\n\n        Test.startTest();\n        List<ConversationEntry> entries =\n            ServicePriorityController.getConversationHistory(wo.Id);\n        Test.stopTest();\n\n        Assert.isFalse(entries.isEmpty(), 'Should return conversation entries');\n        Assert.areEqual('Inbound', entries[0].Direction);\n    }\n\n    @isTest\n    static void testGetActivityFeed() {\n        WorkOrder wo = [SELECT Id FROM WorkOrder LIMIT 1];\n\n        Test.startTest();\n        List<FeedItem> feedItems =\n            ServicePriorityController.getActivityFeed(wo.Id);\n        Test.stopTest();\n\n        Assert.isFalse(feedItems.isEmpty(), 'Should return feed items');\n        Assert.areEqual('Customer called asking for ETA', feedItems[0].Title);\n    }\n\n    @isTest\n    static void testGetWODetails() {\n        WorkOrder wo = [SELECT Id FROM WorkOrder LIMIT 1];\n\n        Test.startTest();\n        ServicePriorityController.WorkOrderDetailWrapper details =\n            ServicePriorityController.getWODetails(wo.Id);\n        Test.stopTest();\n\n        Assert.isNotNull(details, 'Should return WO details');\n        Assert.isNotNull(details.workOrder, 'Should have WorkOrder');\n        Assert.isFalse(details.workOrderLineItems.isEmpty(),\n            'Should have WorkOrderLineItems');\n        Assert.areEqual('Recommend compressor replacement',\n            details.workOrderLineItems[0].Description.substring(10, 42));\n    }\n\n    @isTest\n    static void testGetFollowUpAnalysis_BulkIds() {\n        List<Id> saIds = new List<Id>();\n        for (ServiceAppointment sa : [SELECT Id FROM ServiceAppointment]) {\n            saIds.add(sa.Id);\n        }\n\n        Test.startTest();\n        Map<Id, ServicePriorityController.FollowUpResult> results =\n            ServicePriorityController.getFollowUpAnalysis(saIds);\n        Test.stopTest();\n\n        Assert.isFalse(results.isEmpty(), 'Should return results for all SAs');\n        Assert.isTrue(results.containsKey(saIds[0]),\n            'Should have result for the first SA');\n    }\n\n    @isTest\n    static void testGetFollowUpAnalysis_NullInput() {\n        Test.startTest();\n        Map<Id, ServicePriorityController.FollowUpResult> results =\n            ServicePriorityController.getFollowUpAnalysis(null);\n        Test.stopTest();\n\n        Assert.isTrue(results.isEmpty(), 'Null input should return empty map');\n    }\n}", "path": "/opt/data/service-priority-dashboard/force-app/main/default/classes/ServicePriorityControllerTest.cls"}