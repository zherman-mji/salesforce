<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Service Priority AI Integration</label>
    <description>Grants the AI agent's integration user write access to AI_* fields and read access to Computed_* fields on ServiceAppointment.</description>

    <!-- Apex class access -->
    <classAccesses>
        <apexClass>ServicePriorityController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ServicePriorityHelper</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Object permissions -->
    <objectPermissions>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <object>ServiceAppointment</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowRead>true</allowRead>
        <object>WorkOrder</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowRead>true</allowRead>
        <object>WorkOrderLineItem</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowRead>true</allowRead>
        <object>Account</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowRead>true</allowRead>
        <object>Contact</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowRead>true</allowRead>
        <object>Asset</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowRead>true</allowRead>
        <object>Task</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowRead>true</allowRead>
        <object>FeedItem</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowRead>true</allowRead>
        <object>FeedComment</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Field permissions -->
    <fieldPermissions>
        <editable>true</editable>
        <field>ServiceAppointment.AI_Flag_Explanation__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ServiceAppointment.AI_Recommended_Next_Steps__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ServiceAppointment.AI_Analysis_Generated_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>ServiceAppointment.Computed_Priority__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>ServiceAppointment.Computed_Signal_Summary__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>